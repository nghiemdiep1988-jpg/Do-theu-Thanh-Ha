# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional public backend URL when deploying frontend statically on GitHub Pages
# (e.g., https://do-theu-thanh-ha-api.onrender.com). Leave empty when running full-stack locally.
VITE_API_BASE_URL=""

# ALLOWED_ORIGINS: Optional comma-separated origins allowed for CORS (e.g. https://username.github.io)
ALLOWED_ORIGINS=""
